# Staging build: this dashboard against switch-server-v2 on staging (its own database, seeded
# test data), deployed from the `stg` branch to https://switchfood-staging-finance.web.app
# (docs/staging.md). Committed on purpose: nothing here is a secret, the app id ships inside the
# apps already. `npm run build:staging` builds with this file and refuses a bundle that contains
# a production value (scripts/build-staging.mjs).
NEXT_PUBLIC_PARSE_APP_ID=switchApp
# The staging server: switch-server-v2 `.env.staging` → PARSE_PUBLIC_SERVER_URL.
NEXT_PUBLIC_PARSE_SERVER_URL=https://switchfood-staging.oa.r.appspot.com
