# Production build: this dashboard against the production Parse server, deployed from `main` by a
# manual run of deploy-production to https://switch-finance.web.app (docs/production.md). Committed on
# purpose: nothing here is a secret, the app id ships inside the apps already.
# `npm run build:production` builds with this file and refuses a bundle that names a staging or
# local server (scripts/build-production.mjs).
NEXT_PUBLIC_PARSE_APP_ID=switchApp
# The production server: switch-server-v2 `.env.prod` → PARSE_PUBLIC_SERVER_URL.
NEXT_PUBLIC_PARSE_SERVER_URL=https://api.switchfood.net
